# GitHub Models (free tier) — create a token at https://github.com/settings/tokens
GITHUB_TOKEN=

# Any model published on GitHub Models, e.g.:
#   openai/gpt-4o-mini
#   openai/gpt-4o
#   meta/Llama-3.3-70B-Instruct
GITHUB_MODEL=openai/gpt-4o-mini

# SQLite database location
DATABASE_URL=file:./data/grants.db

# Backend API port
PORT=3001
